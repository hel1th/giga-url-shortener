APP_ENV=local

# Link Service
BASE_URL=http://localhost:8080
LINK_HTTP_PORT=:8080
LINK_HTTP_READ_TIMEOUT=5s
LINK_HTTP_WRITE_TIMEOUT=10s
LINK_HTTP_IDLE_TIMEOUT=60s
ANALYTICS_GRPC_ADDR=localhost:50051

# Analytics Service (gRPC / HTTP)
ANALYTICS_GRPC_PORT=:50051
ANALYTICS_HTTP_PORT=:8082
ANALYTICS_HTTP_READ_TIMEOUT=5s
ANALYTICS_HTTP_WRITE_TIMEOUT=10s
ANALYTICS_HTTP_IDLE_TIMEOUT=60s

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_DB=shortener
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/shortener?sslmode=disable
POSTGRES_MAX_CONNS=20
POSTGRES_MIN_CONNS=5

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_LINK_TTL=24h

# ClickHouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_ADDR=localhost:9000
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=default
CLICKHOUSE_BATCH_SIZE=500
CLICKHOUSE_FLUSH_INTERVAL=2s
CLICKHOUSE_DIAL_TIMEOUT=5s
CLICKHOUSE_MAX_OPEN_CONNS=20
CLICKHOUSE_MAX_IDLE_CONNS=10
CLICKHOUSE_CONN_MAX_LIFETIME=10m

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_CLICKS=link.clicks
KAFKA_CONSUMER_GROUP=analytics-group

# OpenTelemetry (Jaeger OTLP gRPC endpoint)
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME_LINK=link-service
OTEL_SERVICE_NAME_ANALYTICS=analytics-service

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
